# Demonstration only. Keep it bound to localhost; do not put it behind a proxy.
CRM_LOCAL_DEMO=1

# Optional, for a separate QA server only (never point a test at the user's file):
# CRM_DEMO_DATA_FILE=.local/test-runs/http-state.json

# Future PostgreSQL milestone: replace with a local, private credential.
# The application does not yet use this database.
DATABASE_URL=postgresql://crm:CHANGE_ME@127.0.0.1:5432/crm_jasmin

# AI configuration can be entered in the local Settings screen.
# Never commit the real .env.local file or paste API keys into a conversation.
# OPENROUTER_API_KEY=
# OPENROUTER_ENABLED=false
# OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# CRM_AI_DISABLED=1  # Use for QA servers to block all paid AI calls.
