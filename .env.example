# Local file mode (default). Supabase mode requires every variable below.
CRM_STORAGE_BACKEND=local
CRM_LOCAL_DEMO=1

# Identical Supabase project in local and Vercel, HTTPS public URL:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend only: never prefix these two secrets with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# CRM_SETTINGS_ENCRYPTION_KEY=
# Generate one random 32-byte base64 encryption key and securely keep the same
# value on both environments. Changing it makes stored settings unreadable.

# Explicit isolated test data (never point tests at real local data).
# CRM_DEMO_DATA_FILE=.local/test-runs/http-state.json
# CRM_AI_DISABLED=1

# Legacy local settings are imported to encrypted rows in Supabase.
# Use the Settings screen to change them after migration.
# OPENROUTER_API_KEY=
# CHRONOPOST_PASSWORD=

# The old Prisma schema is not the runtime persistence layer.
# Database migrations live in supabase/migrations; see docs/SUPABASE.md.
